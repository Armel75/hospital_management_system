<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================== -->
    <!-- SÉQUENCE DE NUMÉROTATION DES PATIENTS                                -->
    <!-- Format : PAT-2025-000001                                            -->
    <!-- Prefixe : PAT-YYYY-                                                 -->
    <!-- Padding : 6 chiffres                                                -->
    <!-- =================================================================== -->
    <record id="seq_hospital_patient" model="ir.sequence">
        <field name="name">Patient Hospitalier</field>
        <field name="code">hospital.patient</field>
        <field name="prefix">PAT-%(year)s-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
