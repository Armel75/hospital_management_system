<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================== -->
    <!-- LISTE (TREE) PATIENTS                                                -->
    <!-- =================================================================== -->
    <record id="view_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hospital.patient.tree</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <tree string="Patients">
                <field name="patient_id" string="N° Patient"/>
                <field name="display_name" string="Patient"/>
                <field name="nss_valid" invisible="1"/>
                <field name="age" string="Âge"/>
                <field name="sex" string="Sexe"/>
                <field name="mobile" string="Téléphone"/>
                <field name="email" string="Email"/>
                <field name="total_consultations" string="Consult."/>
                <field name="company_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- FORMULAIRE PATIENT                                                   -->
    <!-- =================================================================== -->
    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <button name="action_open_medical_record"
                            type="object"
                            string="Dossier médical"
                            class="btn-primary"
                            context="{'default_patient_id': active_id}"/>
                    <field name="active" invisible="1"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_medical_record"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-heartbeat"
                                string="Dossier médical">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Dossier médical</span>
                            </div>
                        </button>
                    </div>

                    <!-- En-tête avec identité -->
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <field name="title" placeholder="Civilité..." class="oe_inline"/>
                        </div>
                        <h1>
                            <field name="firstname" placeholder="Prénom" class="oe_inline"/>
                            <field name="lastname" placeholder="Nom" class="oe_inline"/>
                        </h1>
                        <group>
                            <div class="oe_inline">
                                <field name="patient_id" class="oe_inline"/>
                            </div>
                            <div class="oe_inline" groups="base.group_multi_company">
                                <field name="company_id" class="oe_inline"/>
                            </div>
                        </group>
                    </div>

                    <notebook>
                        <!-- ONGLET : Identité -->
                        <page string="Identité">
                            <group string="État civil">
                                <group>
                                    <field name="title" required="1"/>
                                    <field name="firstname" required="1"/>
                                    <field name="lastname" required="1"/>
                                    <field name="birthdate" required="1"/>
                                </group>
                                <group>
                                    <field name="age" widget="statinfo"/>
                                    <field name="age_display" invisible="1"/>
                                    <field name="sex" required="1"/>
                                    <field name="marital_status"/>
                                    <field name="profession"/>
                                </group>
                            </group>
                            <group string="Identifiants administratifs">
                                <group>
                                    <field name="nss"
                                           placeholder="1 99 99 99 999 999 99"/>
                                    <field name="nss_key"/>
                                    <field name="nss_valid" widget="statinfo"/>
                                </group>
                                <group>
                                </group>
                            </group>
                            <group string="Coordonnées">
                                <group>
                                    <field name="mobile" required="1"
                                           placeholder="06 XX XX XX XX"/>
                                    <field name="phone"/>
                                    <field name="email" widget="email"/>
                                </group>
                                <group>
                                    <field name="street" placeholder="Rue..."/>
                                    <field name="street2"/>
                                    <field name="zip" placeholder="Code postal"/>
                                    <field name="city" placeholder="Ville"/>
                                    <field name="country_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- ONGLET : Médical -->
                        <page string="Médical">
                            <group string="Constantes vitales">
                                <group>
                                    <field name="blood_group"/>
                                    <field name="weight" widget="float"/>
                                </group>
                                <group>
                                    <field name="rhesus_factor"/>
                                    <field name="height" widget="float"/>
                                    <field name="bmi" widget="statinfo"/>
                                </group>
                            </group>
                            <separator string="Dossier médical"/>
                            <field name="medical_record_ids">
                                <tree string="Dossier médical" editable="bottom">
                                    <field name="record_type"/>
                                    <field name="pathology"/>
                                    <field name="severity"/>
                                    <field name="condition_active"/>
                                    <field name="date_recorded"/>
                                </tree>
                            </field>
                        </page>

                        <!-- ONGLET : Notes -->
                        <page string="Notes">
                            <group>
                                <field name="notes" nolabel="1" placeholder="Notes internes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- RECHERCHE PATIENTS                                                   -->
    <!-- =================================================================== -->
    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Rechercher un patient">
                <field name="display_name" string="Patient"
                       filter_domain="[('display_name','ilike',self)]"/>
                <field name="patient_id" string="N° Patient"
                       filter_domain="[('patient_id','ilike',self)]"/>
                <field name="nss" string="NSS"
                       filter_domain="[('nss','ilike',self)]"/>
                <field name="mobile" string="Téléphone"
                       filter_domain="[('mobile','ilike',self)]"/>
                <field name="email" string="Email"/>
                <separator/>
                <filter name="group_blood"
                        string="Groupe sanguin"
                        context="{'group_by': 'blood_group'}"/>
                <filter name="group_sex"
                        string="Sexe"
                        context="{'group_by': 'sex'}"/>
                <separator/>
                <filter name="active"
                        string="Actifs"
                        domain="[('active','=',True)]"/>
                <filter name="inactive"
                        string="Inactifs"
                        domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- VUE KANBAN PATIENTS                                                  -->
    <!-- =================================================================== -->
    <record id="view_hospital_patient_kanban" model="ir.ui.view">
        <field name="name">hospital.patient.kanban</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <kanban string="Patients" class="o_kanban_mobile">
                <field name="patient_id"/>
                <field name="display_name"/>
                <field name="age"/>
                <field name="sex"/>
                <field name="birthdate"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="total_consultations"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click" t-attf-class="oe_kanban_card oe_kanban_global_click #{kanban_get_color(kanban_getcol('total_consultations'))}">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('hospital.patient', 'image_128', record.id.raw_value)"
                                     t-att-alt="record.display_name.value"
                                     class="o_image_64_cover"
                                     width="64" height="64"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="display_name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="patient_id"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="sex" widget="badge"/>
                                    <field name="age" widget="statinfo"/>
                                    <div t-if="record.mobile.raw_value">
                                        <i class="fa fa-phone"/> <field name="mobile"/>
                                    </div>
                                    <div t-if="record.email.raw_value">
                                        <i class="fa fa-envelope"/> <field name="email"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-stethoscope"/>
                                        <field name="total_consultations"/> consultations
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- VUE PIVOT / GRAPHIQUE                                                -->
    <!-- =================================================================== -->
    <record id="view_hospital_patient_pivot" model="ir.ui.view">
        <field name="name">hospital.patient.pivot</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <pivot string="Statistiques patients">
                <field name="sex" type="row"/>
                <field name="blood_group" type="row"/>
                <field name="age" interval="year" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_hospital_patient_graph" model="ir.ui.view">
        <field name="name">hospital.patient.graph</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <graph string="Répartition des patients">
                <field name="age" interval="year" type="row"/>
                <field name="sex" type="row"/>
            </graph>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- ACTION WINDOW                                                        -->
    <!-- =================================================================== -->
    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">tree,form,kanban,pivot,graph</field>
        <field name="search_view_id" ref="view_hospital_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Cliquez ici pour enregistrer un nouveau patient
            </p>
            <p>
                Gérez les dossiers patients de votre établissement.
                Utilisez la recherche pour retrouver rapidement un patient
                par son nom, son N° de dossier ou son NSS.
            </p>
        </field>
    </record>

</odoo>
