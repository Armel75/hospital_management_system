<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================== -->
    #                                                                       #
    #  ASSURANCES                                                             #
    #                                                                       #
    <!-- =================================================================== -->

    <record id="view_hospital_billing_insurance_tree" model="ir.ui.view">
        <field name="name">hospital.billing.insurance.tree</field>
        <field name="model">hospital.billing.insurance</field>
        <field name="arch" type="xml">
            <tree string="Assurances">
                <field name="code" string="Code"/>
                <field name="name" string="Assurance"/>
                <field name="coverage_rate" string="Prise en charge %" widget="statinfo"/>
                <field name="coverage_type" string="Type"/>
                <field name="phone" string="Téléphone"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_hospital_billing_insurance_form" model="ir.ui.view">
        <field name="name">hospital.billing.insurance.form</field>
        <field name="model">hospital.billing.insurance</field>
        <field name="arch" type="xml">
            <form string="Assurance">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'assurance..."/>
                        </h1>
                        <group>
                            <field name="code" placeholder="Code..."/>
                        </group>
                    </div>

                    <group string="Couverture">
                        <group>
                            <field name="coverage_type"/>
                            <field name="coverage_rate"
                                   attrs="{'invisible': [('coverage_type', '!=', 'percentage')]}"/>
                            <field name="fixed_amount"
                                   widget="monetary"
                                   attrs="{'invisible': [('coverage_type', '!=', 'fixed')]}"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="invoice_count" widget="statinfo" string="Factures"/>
                        </group>
                    </group>

                    <group string="Coordonnées">
                        <group>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="address" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_billing_insurance_search" model="ir.ui.view">
        <field name="name">hospital.billing.insurance.search</field>
        <field name="model">hospital.billing.insurance</field>
        <field name="arch" type="xml">
            <search string="Rechercher une assurance">
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_billing_insurance" model="ir.actions.act_window">
        <field name="name">Assurances</field>
        <field name="res_model">hospital.billing.insurance</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hospital_billing_insurance_search"/>
    </record>

    <!-- =================================================================== -->
    #                                                                       #
    #  GRILLE TARIFAIRE                                                       #
    #                                                                       #
    <!-- =================================================================== -->

    <record id="view_hospital_billing_rate_tree" model="ir.ui.view">
        <field name="name">hospital.billing.rate.tree</field>
        <field name="model">hospital.billing.rate</field>
        <field name="arch" type="xml">
            <tree string="Grille tarifaire">
                <field name="code" string="Code"/>
                <field name="name" string="Libellé"/>
                <field name="category" string="Catégorie"/>
                <field name="default_price" string="Prix €" widget="monetary" sum="Total"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_hospital_billing_rate_form" model="ir.ui.view">
        <field name="name">hospital.billing.rate.form</field>
        <field name="model">hospital.billing.rate</field>
        <field name="arch" type="xml">
            <form string="Tarif">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Libellé de l'acte..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" required="1"/>
                            <field name="category" required="1"/>
                        </group>
                        <group>
                            <field name="default_price" widget="monetary" required="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_billing_rate_search" model="ir.ui.view">
        <field name="name">hospital.billing.rate.search</field>
        <field name="model">hospital.billing.rate</field>
        <field name="arch" type="xml">
            <search string="Rechercher un tarif">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_billing_rate" model="ir.actions.act_window">
        <field name="name">Grille tarifaire</field>
        <field name="res_model">hospital.billing.rate</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hospital_billing_rate_search"/>
    </record>

    <!-- =================================================================== -->
    #                                                                       #
    #  PAIEMENTS                                                              #
    #                                                                       #
    <!-- =================================================================== -->

    <record id="view_hospital_billing_payment_tree" model="ir.ui.view">
        <field name="name">hospital.billing.payment.tree</field>
        <field name="model">hospital.billing.payment</field>
        <field name="arch" type="xml">
            <tree string="Paiements">
                <field name="invoice_id" string="Facture"/>
                <field name="patient_id" string="Patient"/>
                <field name="payment_date" string="Date"/>
                <field name="amount" string="Montant €" widget="monetary" sum="Total"/>
                <field name="payment_method" string="Mode"/>
                <field name="reference" string="Référence"/>
                <field name="user_id" string="Encaisseur"/>
            </tree>
        </field>
    </record>

    <record id="view_hospital_billing_payment_form" model="ir.ui.view">
        <field name="name">hospital.billing.payment.form</field>
        <field name="model">hospital.billing.payment</field>
        <field name="arch" type="xml">
            <form string="Paiement">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="invoice_id" placeholder="Sélectionnez la facture..."
                                   required="1" options="{'no_create': True}"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="patient_id" invisible="1"/>
                            <field name="amount" widget="monetary" required="1"/>
                            <field name="payment_date" required="1"/>
                        </group>
                        <group>
                            <field name="payment_method" required="1"/>
                            <field name="reference"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_billing_payment_search" model="ir.ui.view">
        <field name="name">hospital.billing.payment.search</field>
        <field name="model">hospital.billing.payment</field>
        <field name="arch" type="xml">
            <search string="Rechercher un paiement">
                <field name="invoice_id"/>
                <field name="patient_id"/>
                <field name="reference"/>
                <filter name="today" string="Aujourd'hui" date="payment_date"/>
                <filter name="group_method" string="Mode"
                        context="{'group_by': 'payment_method'}"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_billing_payment" model="ir.actions.act_window">
        <field name="name">Paiements</field>
        <field name="res_model">hospital.billing.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hospital_billing_payment_search"/>
    </record>

</odoo>
