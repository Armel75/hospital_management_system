<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================== -->
    <!-- SÉQUENCE DE NUMÉROTATION DES FACTURES                                -->
    <!-- Format : FAC-YYYY-000001                                            -->
    <!-- =================================================================== -->
    <record id="seq_hospital_billing_invoice" model="ir.sequence">
        <field name="name">Facture patient</field>
        <field name="code">hospital.billing.invoice</field>
        <field name="prefix">FAC-%(year)s-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
