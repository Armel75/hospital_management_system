<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================== -->
    <!-- SÉQUENCE DE NUMÉROTATION DES CONSULTATIONS                           -->
    <!-- Format : CONS-YYYY-000001                                           -->
    <!-- Prefixe : CONS-YYYY-                                                -->
    <!-- Padding : 6 chiffres                                                -->
    <!-- =================================================================== -->
    <record id="seq_hospital_consultation" model="ir.sequence">
        <field name="name">Consultation Médicale</field>
        <field name="code">hospital.consultation</field>
        <field name="prefix">CONS-%(year)s-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
