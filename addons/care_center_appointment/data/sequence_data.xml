<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================== -->
    <!-- SÉQUENCE DE NUMÉROTATION DES RENDEZ-VOUS                             -->
    <!-- Format : RDV-YYYY-000001                                            -->
    <!-- Prefixe : RDV-YYYY-                                                 -->
    <!-- Padding : 6 chiffres                                                -->
    <!-- =================================================================== -->
    <record id="seq_hospital_appointment" model="ir.sequence">
        <field name="name">Rendez-vous Médical</field>
        <field name="code">hospital.appointment</field>
        <field name="prefix">RDV-%(year)s-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
