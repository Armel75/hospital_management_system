<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================== -->
    <!-- LISTE (TREE) RENDEZ-VOUS                                             -->
    <!-- =================================================================== -->
    <record id="view_hospital_appointment_tree" model="ir.ui.view">
        <field name="name">hospital.appointment.tree</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <tree string="Rendez-vous"
                  decoration-warning="state == 'draft'"
                  decoration-info="state == 'confirmed'"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'cancelled'"
                  decoration-muted="state == 'noshow'"
                  default_order="appointment_date ASC">
                <field name="appointment_id" string="N°"/>
                <field name="patient_id" string="Patient"/>
                <field name="doctor_id" string="Médecin"/>
                <field name="appointment_date" string="Date"/>
                <field name="duration_minutes" string="Durée"/>
                <field name="appointment_type" string="Type"/>
                <field name="state" string="Statut" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'in_progress'"
                       decoration-primary="state == 'draft'"
                       decoration-danger="state == 'cancelled'"
                       decoration-muted="state == 'noshow'"/>
                <field name="company_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- FORMULAIRE RENDEZ-VOUS                                               -->
    <!-- =================================================================== -->
    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form string="Rendez-vous">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Confirmer"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start"
                            type="object"
                            string="Démarrer la consultation"
                            class="btn-success"
                            invisible="state != 'confirmed'"/>
                    <button name="action_done"
                            type="object"
                            string="Terminer"
                            invisible="state != 'in_progress'"/>
                    <button name="action_noshow"
                            type="object"
                            string="Non honoré"
                            invisible="state not in ('confirmed', 'in_progress')"
                            confirm="Confirmer que le patient ne s'est pas présenté ?"/>
                    <button name="action_cancel"
                            type="object"
                            string="Annuler"
                            invisible="state not in ('draft', 'confirmed', 'in_progress')"
                            confirm="Êtes-vous sûr de vouloir annuler ce rendez-vous ?"/>
                    <button name="action_draft"
                            type="object"
                            string="Réouvrir"
                            invisible="state not in ('cancelled', 'noshow')"/>
                    <field name="state" string="Statut" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done"
                           clickable="False"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_patient"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user"
                                string="Fiche patient"/>
                        <button name="action_open_consultation"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-stethoscope"
                                string="Consultation"
                                invisible="not consultation_id"/>
                    </div>

                    <!-- En-tête -->
                    <div class="oe_title">
                        <h1>
                            <field name="patient_id"
                                   placeholder="Sélectionnez un patient..."
                                   required="1"
                                   class="oe_inline"/>
                        </h1>
                        <group>
                            <div class="oe_inline">
                                <field name="appointment_id" class="oe_inline"/>
                            </div>
                            <div class="oe_inline" groups="base.group_multi_company">
                                <field name="company_id" class="oe_inline"/>
                            </div>
                        </group>
                    </div>

                    <group>
                        <group>
                            <field name="doctor_id"
                                   options="{'no_create': True}"/>
                            <field name="appointment_date" required="1"/>
                            <field name="duration_minutes"/>
                            <field name="end_datetime" widget="datetime"/>
                        </group>
                        <group>
                            <field name="appointment_type" required="1"/>
                            <field name="contact_phone" placeholder="06 XX XX XX XX"/>
                            <field name="consultation_id"
                                   invisible="consultation_id == False"
                                   widget="many2one_button"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ONGLET : Motif -->
                        <page string="Motif">
                            <group>
                                <field name="reason" nolabel="1"
                                       placeholder="Motif du rendez-vous..."
                                       required="1"/>
                            </group>
                        </page>

                        <!-- ONGLET : Notes -->
                        <page string="Notes">
                            <group>
                                <field name="notes" nolabel="1"
                                       placeholder="Notes internes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- RECHERCHE RENDEZ-VOUS                                                -->
    <!-- =================================================================== -->
    <record id="view_hospital_appointment_search" model="ir.ui.view">
        <field name="name">hospital.appointment.search</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <search string="Rechercher un rendez-vous">
                <field name="appointment_id" string="N° RDV"
                       filter_domain="[('appointment_id','ilike',self)]"/>
                <field name="patient_id" string="Patient"/>
                <field name="doctor_id" string="Médecin"/>
                <field name="reason" string="Motif"
                       filter_domain="[('reason','ilike',self)]"/>
                <separator/>
                <filter name="state_draft"
                        string="Brouillons"
                        domain="[('state','=','draft')]"/>
                <filter name="state_confirmed"
                        string="Confirmés"
                        domain="[('state','=','confirmed')]"/>
                <filter name="state_today"
                        string="Aujourd'hui"
                        help="Rendez-vous du jour"
                        date="appointment_date"/>
                <filter name="state_future"
                        string="À venir"
                        domain="[('appointment_date','>',context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <separator/>
                <filter name="group_state"
                        string="Statut"
                        context="{'group_by': 'state'}"/>
                <filter name="group_doctor"
                        string="Médecin"
                        context="{'group_by': 'doctor_id'}"/>
                <filter name="group_type"
                        string="Type"
                        context="{'group_by': 'appointment_type'}"/>
                <filter name="group_date"
                        string="Date"
                        context="{'group_by': 'appointment_date'}"/>
                <separator/>
                <filter name="noshow"
                        string="Non honorés"
                        domain="[('state','=','noshow')]"/>
            </search>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- VUE KANBAN RENDEZ-VOUS                                               -->
    <!-- =================================================================== -->
    <record id="view_hospital_appointment_kanban" model="ir.ui.view">
        <field name="name">hospital.appointment.kanban</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <kanban string="Rendez-vous" class="o_kanban_mobile">
                <field name="appointment_id"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="state"/>
                <field name="appointment_date"/>
                <field name="appointment_type"/>
                <field name="reason"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{kanban_get_color(kanban_getcol('doctor_id'))}">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('hospital.patient', 'image_128', record.patient_id.raw_value)"
                                     t-att-alt="record.patient_id.value"
                                     class="o_image_64_cover"
                                     width="64" height="64"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="patient_id"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="appointment_id"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="state" widget="badge"/>
                                    <div>
                                        <i class="fa fa-user-md"/>
                                        <field name="doctor_id"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-calendar"/>
                                        <field name="appointment_date"/>
                                    </div>
                                    <div>
                                        <field name="appointment_type"/>
                                    </div>
                                    <div t-if="record.reason.raw_value">
                                        <i class="fa fa-question-circle"/>
                                        <field name="reason"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- VUE CALENDRIER RENDEZ-VOUS (TOP 1%)                                  -->
    <!-- =================================================================== -->
    <record id="view_hospital_appointment_calendar" model="ir.ui.view">
        <field name="name">hospital.appointment.calendar</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Planning des rendez-vous"
                      date_start="appointment_date"
                      date_stop="end_datetime"
                      color="doctor_id"
                      mode="week">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="state"/>
                <field name="appointment_type"/>
            </calendar>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- VUE PIVOT / GRAPHIQUE                                                -->
    <!-- =================================================================== -->
    <record id="view_hospital_appointment_pivot" model="ir.ui.view">
        <field name="name">hospital.appointment.pivot</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <pivot string="Statistiques des rendez-vous">
                <field name="doctor_id" type="row"/>
                <field name="state" type="row"/>
                <field name="appointment_type" type="row"/>
                <field name="appointment_date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_hospital_appointment_graph" model="ir.ui.view">
        <field name="name">hospital.appointment.graph</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <graph string="Évolution des rendez-vous">
                <field name="appointment_date" interval="month" type="row"/>
                <field name="state" type="row"/>
            </graph>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- ACTION WINDOW                                                        -->
    <!-- =================================================================== -->
    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Rendez-vous</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">tree,form,kanban,calendar,pivot,graph</field>
        <field name="search_view_id" ref="view_hospital_appointment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Cliquez ici pour planifier un nouveau rendez-vous
            </p>
            <p>
                Gérez le planning des rendez-vous de votre établissement.
                Visualisez l'agenda par médecin, suivez les confirmations
                et les éventuels rendez-vous non honorés.
            </p>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- ACTION D'AGENDA PAR MÉDECIN                                          -->
    <!-- =================================================================== -->
    <record id="action_hospital_appointment_agenda" model="ir.actions.act_window">
        <field name="name">Mon agenda</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">calendar,tree</field>
        <field name="domain">[('doctor_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Aucun rendez-vous planifié
            </p>
            <p>
                Visualisez votre agenda personnel avec vos rendez-vous.
            </p>
        </field>
    </record>

</odoo>
