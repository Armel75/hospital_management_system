    <record id="cat_anti_infectieux" model="hospital.pharmacy.category">
        <field name="name">Anti-infectieux</field>
        <field name="sequence">30</field>
    </record>

    <record id="cat_systeme_digestif" model="hospital.pharmacy.category">
        <field name="name">Système digestif et métabolisme</field>
        <field name="sequence">40</field>
    </record>

    <record id="cat_systeme_respiratoire" model="hospital.pharmacy.category">
        <field name="name">Système respiratoire</field>
