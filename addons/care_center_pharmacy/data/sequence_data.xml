<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================== -->
    <!-- SÉQUENCE DE NUMÉROTATION DES DÉLIVRANCES                            -->
    <!-- Format : DISP-YYYY-000001                                           -->
    <!-- =================================================================== -->
    <record id="seq_hospital_pharmacy_dispensing" model="ir.sequence">
        <field name="name">Délivrance de médicaments</field>
        <field name="code">hospital.pharmacy.dispensing</field>
        <field name="prefix">DISP-%(year)s-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
