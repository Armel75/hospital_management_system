# =============================================================================
# EXEMPLE — Secret registre GHCR (à adapter avec vos vraies valeurs)
# Créer un secret docker-registry dans le cluster pour que k3s puisse pull
# les images privées GHCR (référencé par imagePullSecrets: ghcr-pull).
#
#   kubectl create secret docker-registry ghcr-pull \
#     --docker-server=ghcr.io \
#     --docker-username=<GH_USER> \
#     --docker-password=<GH_TOKEN> \
#     -n hospital
#   # Répéter pour hospital-staging
#
# ⚠️  Ne jamais committer ce fichier tel quel : utiliser un SealedSecret ou
#     le secret d'imagePullSecrets via kubectl directement.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull
  namespace: hospital
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {
      "auths": {
        "ghcr.io": {
          "username": "CHANGE_ME",
          "password": "CHANGE_ME",
          "auth": "CHANGE_ME_base64_user:password"
        }
      }
    }
